
* {
  box-sizing: border-box;
}

html,
body {
  width: 100%;
  min-height: 100%;
  margin: 0;
}

body {
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: #f7f3e2;
}

/* Keeps the screenshots at their original shape */
.screen {
  position: relative;
  width: min(100vw, 140.625vh);
  aspect-ratio: 1440 / 1024;
  background-position: center;
  background-repeat: no-repeat;
  background-size: 100% 100%;
  overflow: hidden;
}

.welcome-screen {
  background-image: none;
  background-color: #f7f3e2;
}

.login-screen {
  background-image: url("images/login.png");
}

/* Clickable area over the Get Started button in the picture */
.get-started {
  position: absolute;
  left: 32.4%;
  top: 71.8%;
  width: 35.2%;
  height: 12.6%;
  border-radius: 60px;
}

/* Real email and password fields placed over the picture */
.login-form {
  position: absolute;
  inset: 0;
}

.login-input {
  position: absolute;
  left: 5.2%;
  width: 29.7%;
  border: 0;
  border-radius: 10px;
  background: transparent;
  text-align: center;
  font-size: clamp(14px, 1.4vw, 22px);
  color: #222;
}

.login-input::placeholder {
  color: transparent;
}

.login-input:focus,
.login-input:not(:placeholder-shown) {
  background: #d9d9d9;
  outline: 2px solid #315b45;
}

.email-input {
  top: 58.5%;
  height: 6%;
}

.password-input {
  top: 72.1%;
  height: 6.4%;
}

.sign-in-button {
  position: absolute;
  left: 34.9%;
  top: 84%;
  width: 30.3%;
  height: 11.8%;
  border: 0;
  border-radius: 60px;
  background: transparent;
  color: transparent;
  font-size: 0;
  cursor: pointer;
}

.get-started:focus,
.sign-in-button:focus {
  outline: 3px solid #315b45;
}

.screen-reader-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.welcome-content {
  position: absolute;
  inset: 0;
  text-align: center;
  color: #315b45;
}

.welcome-brand {
  position: absolute;
  top: 4%;
  left: 0;
  width: 100%;
  padding: 0 2%;
}

.welcome-brand h1 {
  margin: 0;
  color: #315b45;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(3rem, 8vw, 7.5rem);
  font-weight: 900;
  line-height: 1;
}

.welcome-tagline {
  margin: 1rem 0 0;
  color: #b7d49d;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(0.9rem, 2vw, 1.8rem);
  font-weight: bold;
  font-style: italic;
}

.welcome-title {
  position: absolute;
  top: 40%;
  left: 0;
  width: 100%;
  margin: 0;
  padding: 0 2%;
  color: #315b45;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2rem, 5.3vw, 5rem);
  font-style: italic;
}

.welcome-button {
  position: absolute;
  top: 71.8%;
  left: 50%;
  transform: translateX(-50%);
  width: 35.2%;
  height: 12.6%;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background-color: #0c8c13;
  color: white;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.5rem, 4vw, 3.5rem);
  font-weight: bold;
  font-style: italic;
  text-decoration: none;
}

@media (max-width: 600px) {
  .welcome-button {
    top: 68%;
    width: min(70%, 20rem);
    height: auto;
    min-height: 3.25rem;
    padding: 0.5rem 1rem;
    font-size: clamp(1.125rem, 6vw, 1.5rem);
  }
}

.team-credit {
  position: absolute;
  top: 96%;
  left: 0;
  width: 100%;
  margin: 0;
  transform: translateY(-100%);
  color: #12351f;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(0.8rem, 1.5vw, 1.3rem);
  font-weight: bold;
}

@media (max-width: 600px) {
  .welcome-button {
    top: 68%;
    width: min(70%, 20rem);
    height: auto;
    min-height: 3.25rem;
    padding: 0.5rem 1rem;
    font-size: clamp(1.125rem, 6vw, 1.5rem);
    white-space: nowrap;
  }
}
.auth-screen {
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 35px 20px;
    background-color: #f7f3e2;
    overflow: auto;
}

.auth-container {
    width: 100%;
    max-width: 520px;
    text-align: center;
}

.auth-brand {
    margin-bottom: 28px;
}

.auth-brand h1 {
    margin: 0;
    color: #315b45;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3rem, 9vw, 5rem);
    font-weight: 900;
    line-height: 1;
}

.auth-brand p {
    margin: 12px 0 0;
    color: #8da875;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(0.7rem, 2vw, 0.95rem);
    font-weight: bold;
    font-style: italic;
    line-height: 1.5;
}

.auth-card {
    width: 100%;
    padding: 35px;
    background-color: #fffdf5;
    border: 1px solid #e5e6d5;
    border-radius: 22px;
    box-shadow: 0 12px 35px rgba(49, 91, 69, 0.10);
}

.auth-card h2 {
    margin: 0;
    color: #315b45;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 5vw, 2.4rem);
    font-style: italic;
}

.auth-description {
    margin: 12px 0 28px;
    color: #68796b;
    font-size: 0.95rem;
    line-height: 1.6;
}

.auth-field {
    margin-bottom: 20px;
    text-align: left;
}

.auth-field label {
    display: block;
    margin-bottom: 8px;
    color: #315b45;
    font-size: 0.95rem;
    font-weight: bold;
}

.auth-field input,
.auth-field select {
    width: 100%;
    padding: 14px 15px;
    border: 1px solid #d6dfd0;
    border-radius: 10px;
    outline: none;
    background-color: #ffffff;
    color: #263d30;
    font-family: Arial, sans-serif;
    font-size: 1rem;
}

.auth-field input:focus,
.auth-field select:focus {
    border-color: #315b45;
    box-shadow: 0 0 0 3px rgba(49, 91, 69, 0.10);
}

.auth-field input::placeholder {
    color: #9ba69a;
}

.auth-submit {
    width: 100%;
    min-height: 52px;
    margin-top: 8px;
    border: none;
    border-radius: 999px;
    background-color: #0c8c13;
    color: white;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.2rem;
    font-weight: bold;
    font-style: italic;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.2s;
}

.auth-submit:hover {
    background-color: #096f10;
    transform: translateY(-1px);
}

.auth-submit:disabled {
    opacity: 0.7;
    cursor: wait;
    transform: none;
}

.auth-message {
    min-height: 20px;
    margin: 15px 0 0;
    color: #315b45;
    font-size: 0.9rem;
    overflow-wrap: anywhere;
}

.auth-divider {
    display: flex;
    align-items: center;
    gap: 15px;
    margin: 18px 0;
    color: #a0ad9c;
    font-size: 0.8rem;
}

.auth-divider::before,
.auth-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background-color: #e3e7dc;
}

.auth-switch-text {
    margin: 0;
    color: #68796b;
    font-size: 0.95rem;
}

.auth-switch-text button {
    padding: 0;
    border: none;
    background: none;
    color: #0c8c13;
    font-size: inherit;
    font-weight: bold;
    cursor: pointer;
}

.auth-switch-text button:hover {
    text-decoration: underline;
}

.back-home {
    display: inline-block;
    margin-top: 22px;
    color: #315b45;
    font-size: 0.9rem;
    text-decoration: none;
}

.back-home:hover {
    text-decoration: underline;
}

.auth-footer {
    margin-top: 25px;
    color: #809176;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.9rem;
    font-style: italic;
    line-height: 1.8;
}

@media (max-width: 600px) {
    .auth-screen {
        padding: 25px 16px;
    }

    .auth-card {
        padding: 28px 22px;
    }

    .auth-brand {
        margin-bottom: 22px;
    }
}
